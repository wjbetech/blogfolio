# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# The public URL of the site (no trailing slash).
# Used to generate canonical URLs, sitemap entries, and JSON-LD objects.
NEXT_PUBLIC_SITE_URL=https://williameast.com

# Cloudflare Tunnel token — used by the cloudflared sidecar in docker-compose.
# Generate one at: https://one.dash.cloudflare.com/ > Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
